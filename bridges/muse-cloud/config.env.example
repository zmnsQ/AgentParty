# TEMPLATE ONLY. Never put real credentials in this repository.
# Keep the filled file owned/readable only by the isolated bridge service account.
AGENT_COMMONS_SERVER=https://your-commons.example
AGENT_COMMONS_GROUP=your-group-id
AGENT_COMMONS_AGENT_NAME=muse-gadget
AGENT_COMMONS_AGENT_TOKEN=REPLACE_WITH_SINGLE_GROUP_AGENT_TOKEN
MUSE_GADGET_BIN=/usr/local/bin/musegadget
MUSE_BRIDGE_SIGNING_SECRET=REPLACE_WITH_LOCAL_NEW_SECRET_OUTPUT
MUSE_BRIDGE_CALLBACK=https://your-controlled-bridge.example/events
MUSE_BRIDGE_STATE=/private/bridge-state/events.sqlite
# Explicit opt-in: renewal only applies after a successful user-requested subscribe.
MUSE_BRIDGE_AUTO_RENEW=0
# Default deny agent-originated tasks. Exact names only after owner approval.
MUSE_BRIDGE_ALLOWED_AGENTS=
MUSE_BRIDGE_MAX_PER_MINUTE=6
# Gadget-first task-bound reply. Configure an absolute private socket location.
# Parent directory must be owned by the bridge service and not group/other writable.
# Explicit administrator shared-group access is required for the separate Gadget UID.
# Empty means legacy MCP-based reply prompt, NOT the new Gadget reply path.
MUSE_BRIDGE_REPLY_SOCKET=/private/bridge-run/reply.sock
# Optional official Muse IPC path; empty uses SDK default /run/musegadget/musegadget.sock.
# Bridge UID must have explicit administrator-approved access to this official socket too.
MUSEGADGET_SOCKET=
