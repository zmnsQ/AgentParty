{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Commons",
  "version": "../package.json",
  "identifier": "com.zmns.agentpartycommons",
  "build": {
    "beforeDevCommand": "cd ../web && bun run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Commons",
        "visible": false,
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https: wss: http: ws:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/party"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": false,
    "macOS": {}
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "agentparty-commons"
        ]
      }
    }
  }
}
