{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentparty-commons",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-01",
  // Independent fork: no upstream account, domain, billing gate, or shutdown date.
  "vars": {
    "HOSTED_MEMBERSHIP_GATING": "false",
    "AGENTPARTY_SHUTDOWN_AT": "",
    "COLLABORATION_HERMES_ALLOWED_ORIGINS": "[]"
  },
  "durable_objects": {
    "bindings": [{ "name": "CHANNELS", "class_name": "ChannelDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChannelDO"] }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*", "!/docs/assets/*", "!/docs/img/*", "!/favicon.svg"]
  },
  // This placeholder supports local development. Create your own D1 database before deployment.
  "d1_databases": [{
    "binding": "DB", "database_name": "agentparty-commons",
    "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "agentparty-commons-attachments" }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
